# development | production
VITE_APP_ENV=production

# Base path Vite
# cierrelmds (Apache strip /admin → :5200/): VITE_APP_BASE=./
# QA / IP:puerto directo (:5200/):       VITE_APP_BASE=/  (+ VITE_DIRECT_ACCESS=1 opcional)
# No usar base /admin/ en Vite con Apache (bucle 302 en preview).
VITE_APP_BASE=./

# SOLO IP http://192.168.8.120:5200 — NO usar en srv001 si entras por cierrelmds /admin/
# (rompe assets: /admin/empresas/assets/... 404). Usar scripts/build-cierrelmds.sh en 120.
# VITE_DIRECT_ACCESS=1
# VITE_APP_BASE=/

# URL de exelixi-nexus-services (proxy dev/preview de /api)
# Local:     http://localhost:3092
# cierrelmds: https://cierrelmds.exelixitech.com/nexus-api
VITE_API_URL=http://localhost:3092
